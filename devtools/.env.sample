# Copied to .env by `make env`. Docker Compose reads .env on its own.

# The app's user in its container: set them to `id -u` / `id -g`, so that it owns what you copy
# into the container with `docker compose cp`.
APP_UID=1000
APP_GID=1000

# Host address Gradio is published on. 127.0.0.1 keeps the unauthenticated interface on
# this machine; use 0.0.0.0 only on a network you trust.
GRADIO_BIND_ADDRESS=127.0.0.1

LOG_LEVEL=INFO

# Cloud models, offered beside the local one only when both are set. The local model stays the
# default, and nothing goes to Anthropic unless a request picks one of its models. Setting or
# changing these takes `make up`, which recreates the app container and empties the library.
ANTHROPIC_API_KEY=
# Comma-separated, in the order the tabs list them, such as claude-sonnet-5-5,claude-opus-5-5.
ANTHROPIC_MODELS=

# OpenAI's models, offered beside the local one only when both are set, after Claude's. Nothing
# goes to OpenAI unless a request picks one of its models. The key is an API key from
# platform.openai.com, billed per token; a ChatGPT subscription isn't one. Setting or changing
# these takes `make up`, which recreates the app container and empties the library.
OPENAI_API_KEY=
# Comma-separated, in the order the tabs list them, such as gpt-6-luna,gpt-6.1-terra,gpt-6.2-sol.
# Models that reason only: cloud_profiles.openai sends each request a reasoning effort.
OPENAI_MODELS=
