# Copied to .env by `make env`. Docker Compose reads .env on its own.

# Owner of the files the app writes to ./data and ./logs: set them to `id -u` / `id -g`.
APP_UID=1000
APP_GID=1000

# Host address Gradio is published on. 127.0.0.1 keeps the unauthenticated interface on
# this machine; use 0.0.0.0 only on a network you trust.
GRADIO_BIND_ADDRESS=127.0.0.1

LOG_LEVEL=INFO
