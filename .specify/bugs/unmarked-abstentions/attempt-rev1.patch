+def _reply(settings, runtime, model, question, passage, language):
+    """Ask as the application does, with the configured temperature and token limit."""
+    try:
+        runtime.model_info(model)
+    except ModelNotFoundError:
+        pytest.skip(f"{model} isn't pulled")
+    llm = create_llm_provider(apply_overrides(settings, {"llm": {"model": model}}), runtime)
+    task = settings.generation.question_answering
+    parameters = GenerationParameters(
+        temperature=settings.llm.temperature if task.temperature is None else task.temperature,
+        max_tokens=task.max_tokens or settings.llm.max_tokens,
+        seed=SEED,
+    )
+    return read_reply(llm.generate(question_answering_messages(question, [passage], language), parameters), [passage])
+
