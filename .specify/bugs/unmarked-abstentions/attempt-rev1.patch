+# language (.specify/bugs/unmarked-abstentions/fix.md).
+_KNOWN_WRONG_ABSTENTIONS = {("gpt-oss:20b", "French"), ("gpt-oss:20b", "German")}
+
+
+@pytest.mark.parametrize(
+    ("model", "language"),
+    [
+        pytest.param(*case, marks=pytest.mark.xfail(reason="a known wrong abstention, see above"))
+        if case in _KNOWN_WRONG_ABSTENTIONS
+        else case
+        for case in CASES
+    ],
+)
+def test_a_question_answered_in_part_is_answered_not_abstained_from(settings, runtime, model, language):
+    question = "O que aconteceu com a denúncia contra o testamento de Quincas Borba, e quem a apresentou?"
+
+    reply = _reply(settings, runtime, model, question, DENUNCIATION, language)
+
+    assert not reply.insufficient_evidence, reply.text
